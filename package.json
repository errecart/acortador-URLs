{
  "name": "acortador-urls",
  "version": "1.0.0",
  "description": "Zero-dependency self-hosted URL shortener with a web UI, JSON API, and CLI.",
  "main": "server.js",
  "bin": {
    "acortador-urls": "./bin/acortador.js"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "prestart:secure": "node -e \"require('node:fs').mkdirSync('data', { recursive: true })\"",
    "start:secure": "node scripts/start-secure.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errecart/acortador-URLs.git"
  },
  "keywords": [
    "url-shortener",
    "shortener",
    "nodejs",
    "http",
    "zero-dependencies"
  ],
  "author": "errecart",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "bugs": {
    "url": "https://github.com/errecart/acortador-URLs/issues"
  },
  "homepage": "https://github.com/errecart/acortador-URLs#readme"
}
